# URL publik kanonis (untuk SEO: canonical, sitemap, robots, Open Graph).
# Contoh produksi: SITE_URL=https://hgitopup.web.id
SITE_URL=http://localhost:3000
PORT=3000
JWT_SECRET=ganti-dengan-secret-minimal-32-karakter
JWT_EXPIRES_IN=7d
MASTER_API_KEY=ganti-dengan-api-key-acak-minimal-32-karakter
DATABASE_URL=mysql://user:pass@localhost:3306/pansa_gateway
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULL_NAME=Administrator
SEED_ADMIN_PASSWORD=ganti-password-admin-awal
GLOBAL_WEBHOOK_URL=
# Opsional: secret HMAC global bila memakai GLOBAL_WEBHOOK_URL (tanpa ini, tanpa signature).
GLOBAL_WEBHOOK_SECRET=
SESSIONS_DIR=./data/sessions
MEDIA_DIR=./data/media
MAX_MEDIA_MB=64
# Batas session aktif per user non-admin (default 2). Session stopped/logged_out tidak dihitung.
MAX_SESSIONS_PER_USER=2
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PAIRING=20
# Opsional: batasi percobaan auth (per IP per 15 menit). Default bila kosong: 20/10/10.
RATE_LIMIT_REGISTER=20
RATE_LIMIT_FORGOT=10
RATE_LIMIT_RESET=10
# Nama + tagline web (bisa juga diubah via panel admin; DB diutamakan, env fallback).
SITE_NAME=Pansa Gateway
SITE_TAGLINE=Gateway WhatsApp multi-user — kelola session, chat, grup, dan blast.
# Pendaftaran akun publik (bisa juga diubah via panel admin; DB diutamakan, env fallback).
REGISTRATION_ENABLED=true
# SMTP untuk email reset password (bisa juga diubah via panel admin; DB diutamakan, env fallback).
# Kosongkan bila belum ada — forgot-password menjawab 503 sampai SMTP dikonfigurasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Pansa Gateway
